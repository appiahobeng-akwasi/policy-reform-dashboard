# Copy this file to .env and fill in the values. Never commit .env.
# No real keys belong in this file.
# Admin commands can read another file instead: ENV_FILE=.env.hosted npm run users:add -- ...
# (docs/04 section 6b). Build for Vercel with ASTRO_ADAPTER=vercel; Node is the default.

# Postgres connection used by the app, db:reset, db:migrate, users:add and the tests.
# Local Supabase: port 54322. Any other Postgres 15+ works the same way.
# db:reset refuses to run against anything that is not on this machine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Root certificate the database's certificate must chain to (decision 91), as PEM or as the PEM
# in base64 on one line. When set, the app and the backup verify the certificate and host name.
# Hosted Supabase: npm run hosted:setup sets it from db/platform/supabase-root-2021.crt. Leave
# empty for a local database.
DATABASE_SSL_CA=

# Database connections each copy of the app keeps open. Keep the total across copies under the
# database's own limit.
DATABASE_POOL_SIZE=10

# Public address of the app. Sign-in links return here.
APP_BASE_URL=http://localhost:4321

# Supabase Auth (sign-in). Server-side only; the browser never talks to Supabase.
# Locally: run `supabase status` and copy "API URL" and "Publishable key".
# Hosted: from the project's API settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Admin API key, server only: shows who has set up an authenticator app and lets a super
# administrator reset one. Locally: "Secret key" from `supabase status`. Never expose it to browsers.
SUPABASE_SECRET_KEY=

# File storage for evidence: any S3-compatible store. Server-side only.
# Locally: run `supabase status` and copy the "S3 Access Key" and "S3 Secret Key" (local defaults).
# S3_PUBLIC_ENDPOINT is the address browsers use for download links, if different from S3_ENDPOINT.
# Run `npm run storage:setup` once to create the bucket.
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_PUBLIC_ENDPOINT=
S3_REGION=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=dashboard-files
S3_FORCE_PATH_STYLE=true

# Outgoing email for reminders and digests, by SMTP. Server-side only.
# Locally: Mailpit catches everything (nothing is really sent); see it at http://127.0.0.1:54324.
# Hosted: Resend (decision 93), set by npm run hosted:email: smtp.resend.com, port 465, secure,
# user resend, SMTP_PASS a Resend API key. Leave SMTP_HOST empty to keep reminders in the app only.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pillar 1 dashboard <no-reply@localhost>

# Shared secret for scheduled jobs: the scheduler sends it as "Authorization: Bearer <secret>"
# to POST /api/jobs/<nightly|daily|weekly|month_end>. Use a long random value; leave empty to
# close that address (the npm run jobs command still works).
JOBS_SECRET=

# Behind a proxy or load balancer, set to true so rate limits see each person's own address.
TRUST_PROXY=false
# Addresses not counted by the per-address rate limits, comma-separated (for example a health
# checker). Per-email and per-person limits still apply. Leave empty on a real server.
RATE_LIMIT_IP_EXEMPT=

# Hosted set-up commands only (npm run hosted:setup, hosted:email; decision 95). Not secret.
# Where this copy is hosted, so no project names live in the code. Put them in .env.hosted.
# VERCEL_PROJECT=your-vercel-project
# VERCEL_SCOPE=your-vercel-team-slug
# VERCEL_TEAM_ID=team_...
# ADMIN_EMAIL=you@example.org
# EMAIL_DOMAIN=example.org

# Open-source notice (decision 97): the footer and the About page show the MIT licence. Set your own
# copyright holder and source code address if you publish your own copy.
# COPYRIGHT_HOLDER=Green Growth Programme
# SOURCE_CODE_URL=https://github.com/appiahobeng-akwasi/policy-reform-dashboard

# The data in db/seed is fictional demo data. Every page says so while this is true.
# Set it to false once you load your own data (docs/ADOPTING.md).
DEMO_DATA=true

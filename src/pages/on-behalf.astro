---
// Entering updates for someone else (spec 01 section 5.3): choose the person, then one of their
// items. For programme admins only (decision 30).
import Base from '../layouts/Base.astro';
import { formatDate, t, type MessageKey } from '../i18n';
import { asUser } from '../lib/server-db';

const { lang, user } = Astro.locals;
if (!user) return Astro.redirect('/sign-in?next=%2Fon-behalf', 303);
const allowed = user.role === 'programme_admin' || user.role === 'super_admin';
const selected = Astro.url.searchParams.get('person');
const personId = selected && /^[0-9a-f-]{36}$/.test(selected) ? selected : null;

const data = allowed
  ? await asUser(user.claims, async (db) => {
      const people = await db.query<{ person_id: string; full_name: string }>('select person_id, full_name from people where is_active order by full_name');
      const items = personId
        ? (
            await db.query<{ object_type: string; object_id: string; name: string; reform_id: string | null; due_date: string | null; days_overdue: number }>(
              `select object_type, object_id, name, reform_id, due_date, days_overdue from v_delivery_flags
                where owner_person_id = $1 and status not in ('complete', 'cancelled')
                order by days_overdue > 0 desc, days_overdue desc, is_stale desc, due_date nulls last limit 200`,
              [personId],
            )
          ).rows
        : [];
      return { people: people.rows, items };
    })
  : null;
---

<Base title={t(lang, 'onbehalf.title')}>
  <h1>{t(lang, 'onbehalf.title')}</h1>
  {
    !data ? (
      <p class="notice">{t(lang, 'onbehalf.not_allowed')}</p>
    ) : (
      <>
        <p>{t(lang, 'onbehalf.intro')}</p>
        <form method="get" class="pick">
          <div>
            <label for="person">{t(lang, 'onbehalf.choose_person')}</label>
            <select id="person" name="person" required>
              <option value="">{t(lang, 'onbehalf.pick')}</option>
              {data.people.map((p) => (
                <option value={p.person_id} selected={p.person_id === personId}>
                  {p.full_name}
                </option>
              ))}
            </select>
          </div>
          <button class="button" type="submit">{t(lang, 'onbehalf.show')}</button>
        </form>
        {personId &&
          (data.items.length === 0 ? (
            <p>{t(lang, 'onbehalf.none')}</p>
          ) : (
            <ul class="items">
              {data.items.map((item) => (
                <li>
                  <a href={`/items/${item.object_type}/${item.object_id}?for=${personId}`}>{item.name}</a>
                  <span class="meta">
                    {' · '}
                    {t(lang, `items.type_${item.object_type}` as MessageKey)} {item.object_id} · {item.reform_id ?? t(lang, 'items.programme_wide')}
                    {item.due_date && <> · {formatDate(item.due_date, lang)}</>}
                    {item.days_overdue > 0 && <span class="warn"> · {t(lang, 'items.overdue', { days: item.days_overdue })}</span>}
                  </span>
                </li>
              ))}
            </ul>
          ))}
      </>
    )
  }
</Base>

<style>
  .pick {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  select {
    font: inherit;
    min-height: 2.75rem;
    padding: var(--space-2);
  }
  .items li {
    margin-bottom: var(--space-2);
  }
  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .warn {
    color: var(--color-rag-red);
  }
</style>

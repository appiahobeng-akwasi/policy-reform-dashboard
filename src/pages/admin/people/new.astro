---
// Add someone who owns items but will not sign in (replaces `npm run people:add`). Admins only.
import PersonFields from '../../../components/PersonFields.astro';
import Base from '../../../layouts/Base.astro';
import { t, type MessageKey } from '../../../i18n';
import { ADMIN_ROLES, createPerson, listInstitutions, readPersonForm, type PersonInput, type Problem } from '../../../lib/admin/users';

const { lang, user } = Astro.locals;
if (!user) return Astro.redirect('/sign-in?next=%2Fadmin%2Fpeople%2Fnew', 303);
const allowed = ADMIN_ROLES.includes(user.role);
const institutions = allowed ? await listInstitutions(user.claims) : [];

let value: PersonInput = { name: '', email: null, institutionId: null, roleTitle: null, language: 'fr' };
let problems: Problem[] = [];
let error: string | null = null;
if (allowed && Astro.request.method === 'POST') {
  const read = readPersonForm(
    await Astro.request.formData(),
    institutions.map((i) => i.id),
  );
  value = read.input;
  problems = read.problems;
  if (problems.length === 0) {
    const result = await createPerson(user.claims, value);
    if (result.ok) return Astro.redirect(`/admin/people/${result.value}?done=added`, 303);
    error = result.code;
  }
}
---

<Base title={t(lang, 'admin.add_person')}>
  <p><a href="/admin/people">{t(lang, 'admin.back_people')}</a></p>
  <h1>{t(lang, 'admin.add_person')}</h1>
  {
    !allowed ? (
      <p class="notice">{t(lang, 'admin.not_allowed')}</p>
    ) : (
      <>
        <p>{t(lang, 'admin.add_person_intro')}</p>
        {error && (
          <p class="error" role="alert" data-testid="admin-error">
            {t(lang, `admin.error_${error}` as MessageKey)}
          </p>
        )}
        <form method="post" class="stack narrow">
          <PersonFields value={value} institutions={institutions} problems={problems} />
          <button class="button" type="submit">{t(lang, 'admin.add_person')}</button>
        </form>
      </>
    )
  }
</Base>

---
// One person on the people list: edit them, turn them off, or give them a sign-in account.
// People who already have an account are edited under users and access. Admins only.
import AccessFields from '../../../components/AccessFields.astro';
import PersonFields from '../../../components/PersonFields.astro';
import Base from '../../../layouts/Base.astro';
import { t, type MessageKey } from '../../../i18n';
import { ADMIN_ROLES, getPerson, giveAccess, listInstitutions, readAccessForm, readPersonForm, updatePerson, type PersonInput, type Problem } from '../../../lib/admin/users';
import { asUser } from '../../../lib/server-db';

const { lang, user } = Astro.locals;
const id = Astro.params['id'] ?? '';
if (!user) return Astro.redirect(`/sign-in?next=${encodeURIComponent(`/admin/people/${id}`)}`, 303);
if (!/^[0-9a-f-]{36}$/.test(id)) return new Response(null, { status: 404 });
const allowed = ADMIN_ROLES.includes(user.role);
const institutions = allowed ? await listInstitutions(user.claims) : [];
const reforms = allowed ? await asUser(user.claims, async (db) => (await db.query<{ reform_id: string }>('select reform_id from reforms order by reform_id')).rows.map((r) => r.reform_id)) : [];

let problems: Problem[] = [];
let error: string | null = null;
let edited: PersonInput | null = null;
if (allowed && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'save') {
    const read = readPersonForm(
      form,
      institutions.map((i) => i.id),
    );
    edited = read.input;
    problems = read.problems;
    if (problems.length === 0) {
      const result = await updatePerson(user.claims, id, read.input, form.get('active') === 'on');
      if (result.ok) return Astro.redirect(`/admin/people/${id}?done=saved`, 303);
      error = result.code;
    }
  } else if (action === 'access') {
    const read = readAccessForm(form, reforms);
    if (read.problems.includes('role')) error = 'other';
    else {
      const result = await giveAccess(user.claims, id, read.input.role, read.input.scope);
      if (result.ok) return Astro.redirect(`/admin/users/${result.value}?added=1`, 303);
      error = result.code;
    }
  }
}

const person = allowed ? await getPerson(user.claims, id) : null;
if (allowed && !person) return new Response(null, { status: 404 });
// Someone with an account is managed on the users page.
if (person?.hasAccount) {
  const account = await asUser(user.claims, async (db) => (await db.query<{ user_id: string }>('select user_id from app_users where person_id = $1', [id])).rows[0]);
  if (account) return Astro.redirect(`/admin/users/${account.user_id}`, 303);
}
const value: PersonInput | null =
  edited ?? (person ? { name: person.name, email: person.email, institutionId: person.institutionId, roleTitle: person.roleTitle, language: person.language } : null);
const done = Astro.url.searchParams.get('done');
---

<Base title={person?.name ?? t(lang, 'admin.people_title')}>
  <p><a href="/admin/people">{t(lang, 'admin.back_people')}</a></p>
  {
    !person || !value ? (
      <p class="notice">{t(lang, 'admin.not_allowed')}</p>
    ) : (
      <>
        <h1>{person.name}</h1>
        <p class="muted">{t(lang, 'admin.owns_items', { n: person.items })}</p>
        {done === 'added' && <p class="notice" role="status" data-testid="admin-done">{t(lang, 'admin.done_person_added')}</p>}
        {done === 'saved' && <p class="notice" role="status" data-testid="admin-done">{t(lang, 'admin.done_saved')}</p>}
        {error && (
          <p class="error" role="alert" data-testid="admin-error">
            {t(lang, `admin.error_${error}` as MessageKey)}
          </p>
        )}

        <form method="post" class="stack narrow">
          <input type="hidden" name="action" value="save" />
          <PersonFields value={value} institutions={institutions} problems={problems} />
          <label class="inline">
            <input type="checkbox" name="active" checked={person.isActive} />
            {t(lang, 'admin.person_active')}
          </label>
          <p class="muted">{t(lang, 'admin.person_active_hint')}</p>
          <button class="button" type="submit">{t(lang, 'admin.save')}</button>
        </form>

        <section class="stack narrow">
          <h2>{t(lang, 'admin.give_access_title')}</h2>
          {!person.email ? (
            <p>{t(lang, 'admin.give_access_needs_email')}</p>
          ) : (
            <form method="post" class="stack">
              <input type="hidden" name="action" value="access" />
              <p>{t(lang, 'admin.give_access_intro', { email: person.email })}</p>
              <AccessFields
                value={{ name: person.name, email: person.email, role: 'contributor', language: person.language, scope: [] }}
                reforms={reforms}
                canGrantSuper={user.role === 'super_admin'}
                problems={[]}
                identity={false}
              />
              <button class="button" type="submit">{t(lang, 'admin.give_access')}</button>
            </form>
          )}
        </section>
      </>
    )
  }
</Base>

<style>
  section {
    margin-top: var(--space-8);
  }
  .inline {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: var(--weight-normal);
  }
</style>

---
// My items (docs/01 section 5.1, docs/08 section 3): open items you own, overdue first, then
// stale, then by due date. Reform leads and admins also get "My reforms", including items with no
// owner yet (decision 23). A hero card rings the items by state (docs/08 v0.2: overdue, stale,
// waiting, on track; each item counted once), and a stat row filters the table; selecting an item opens it in the side
// panel (decision 69), from where Update opens the full update card. Read through row-level
// security as the signed-in person; 50 per page.
import ActivityList from '../components/ActivityList.astro';
import DueBar from '../components/DueBar.astro';
import Icon from '../components/Icon.astro';
import ObjectIcon from '../components/ObjectIcon.astro';
import EmptyState from '../components/EmptyState.astro';
import HeroLeaves from '../components/HeroLeaves.astro';
import RagPill from '../components/RagPill.astro';
import SampleBadge from '../components/SampleBadge.astro';
import ReformChip from '../components/ReformChip.astro';
import Ring from '../components/Ring.astro';
import SidePanel from '../components/SidePanel.astro';
import StatCard from '../components/StatCard.astro';
import StatusPill from '../components/StatusPill.astro';
import Base from '../layouts/Base.astro';
import { DISPLAY_TIME_ZONE, formatDate, t, type MessageKey } from '../i18n';
import { loadQueue } from '../lib/approvals';
import { accessFor } from '../lib/shell';
import { BULK_ROLES } from '../lib/bulk/roles';
import { isDeliveryEntity, loadActivity, loadEvidence, loadItem, loadLatestSubmission, mayReadActivity, type DeliveryEntity } from '../lib/items';
import { asUser } from '../lib/server-db';
import { dataAsOf } from '../lib/views';

const PAGE_SIZE = 50;
const SHOWS = ['overdue', 'due30', 'stale', 'waiting'] as const;
type Show = (typeof SHOWS)[number];
const { lang, user } = Astro.locals;
if (!user) return Astro.redirect('/sign-in?next=%2Fmy-items', 303);

const params = Astro.url.searchParams;
const canSeeReforms = ['super_admin', 'programme_admin', 'reform_lead'].includes(user.role);
const tab = canSeeReforms && params.get('tab') === 'reforms' ? 'reforms' : 'mine';
const noOwnerOnly = tab === 'reforms' && params.get('no_owner') === '1';
const show = (SHOWS as readonly string[]).includes(params.get('show') ?? '') ? (params.get('show') as Show) : null;
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
const openMatch = /^([a-z]+)\/([A-Za-z0-9-]+)$/.exec(params.get('open') ?? '');
const open = openMatch && isDeliveryEntity(openMatch[1]!) ? { entity: openMatch[1] as DeliveryEntity, id: openMatch[2]! } : null;
const panelTab = params.get('panel') === 'activity' ? 'activity' : 'overview';

type Row = {
  object_type: string;
  object_id: string;
  reform_id: string | null;
  reform_name_en: string | null;
  reform_name_fr: string | null;
  name: string;
  status: string;
  due_date: string | null;
  rag: string;
  days_overdue: number;
  days_to_due: number | null;
  is_stale: boolean;
  last_confirmed_at: string | null;
  owner_name: string | null;
  pending: string | null;
  is_sample: boolean;
};

// The same rows as the table, before the stat filter: scope (mine or my reforms), open items only.
const SCOPE = `with scoped as (
  select f.*, p.full_name as owner_name, r.name_en as reform_name_en, r.name_fr as reform_name_fr,
         (select s.status from submissions s
           where s.submitted_by = (select (me()).user_id) and s.status not in ('withdrawn', 'applied')
             and s.payload -> 'rows' @> jsonb_build_array(jsonb_build_object('entity', f.object_type, 'id', f.object_id))
           order by s.created_at desc limit 1) as pending
    from v_delivery_flags f left join people p on p.person_id = f.owner_person_id
         left join reforms r on r.reform_id = f.reform_id
   where f.status not in ('complete', 'cancelled')
     and case when $1 = 'mine' then f.owner_person_id = (select (me()).person_id)
              else (select is_admin()) or f.reform_id = any (my_reform_ids()) end
     and (not $2 or f.owner_person_id is null))`;

const data = await asUser(user.claims, async (db) => {
  const items = await db.query<Row>(
    `${SCOPE}
     select object_type, object_id, reform_id, reform_name_en, reform_name_fr, name, status, due_date, rag, days_overdue, days_to_due, is_stale,
            last_confirmed_at::text as last_confirmed_at, owner_name, is_sample, pending
       from scoped
      where case $3 when 'overdue' then days_overdue > 0
                    when 'due30' then days_to_due between 0 and 30
                    when 'stale' then is_stale
                    when 'waiting' then pending = 'proposed'
                    else true end
      order by days_overdue > 0 desc, days_overdue desc, is_stale desc, due_date nulls last, object_id
      limit $4 offset $5`,
    [tab, noOwnerOnly, show ?? '', PAGE_SIZE + 1, (page - 1) * PAGE_SIZE],
  );
  // The stat cards overlap (a stale item can also be overdue); the ring counts each item once.
  const stats = await db.query<{ overdue: number; due30: number; stale: number; waiting: number; total: number; ring_stale: number; ring_waiting: number }>(
    `${SCOPE}
     select count(*) filter (where days_overdue > 0)::int as overdue,
            count(*) filter (where days_to_due between 0 and 30)::int as due30,
            count(*) filter (where is_stale)::int as stale,
            count(*) filter (where pending = 'proposed')::int as waiting,
            count(*)::int as total,
            count(*) filter (where days_overdue = 0 and is_stale)::int as ring_stale,
            count(*) filter (where days_overdue = 0 and not is_stale and pending = 'proposed')::int as ring_waiting
       from scoped`,
    [tab, noOwnerOnly],
  );
  // Needs your action (decision 86): your updates that were returned, or that the checks stopped,
  // and not yet sent again. The oldest one of each kind is where the button goes.
  const mine = await db.query<{ status: string; n: number; submission_id: string; route: string; entity: string | null; item_id: string | null }>(
    `select distinct on (s.status) s.status, count(*) over (partition by s.status)::int as n, s.submission_id, s.route,
            r.entity, r.id as item_id
       from submissions s
       left join lateral (select e ->> 'entity' as entity, e ->> 'id' as id
                            from jsonb_array_elements(s.payload -> 'rows') with ordinality as x(e, k)
                           where e ->> 'entity' in ('workstream', 'deliverable', 'activity', 'milestone')
                           order by k limit 1) r on true
      where s.submitted_by = (select (me()).user_id) and s.status in ('returned', 'rejected_by_gate')
        and not exists (select 1 from submissions n where n.previous_submission_id = s.submission_id)
      order by s.status, s.created_at`,
  );
  // The count on each tab: open items you own, and (for leads and admins) in your reforms.
  const tabCounts = await db.query<{ mine: number; reforms: number | null }>(
    `select count(*) filter (where owner_person_id = (select (me()).person_id))::int as mine,
            case when $1 then count(*) filter (where (select is_admin()) or reform_id = any (my_reform_ids()))::int end as reforms
       from v_delivery_flags where status not in ('complete', 'cancelled')`,
    [canSeeReforms],
  );
  // Where to start: the most overdue item, or else the one confirmed longest ago.
  const first = await db.query<{ name: string; days_overdue: number }>(
    `${SCOPE}
     select name, days_overdue from scoped
      where days_overdue > 0 or is_stale
      order by days_overdue desc, coalesce(last_confirmed_at, updated_at) nulls first, object_id
      limit 1`,
    [tab, noOwnerOnly],
  );
  const lookups = await db.query<{ list_name: string; code: string; label_en: string; label_fr: string }>(
    "select list_name, code, label_en, label_fr from lookup_values where list_name in ('delivery_status', 'rag', 'validation_status')",
  );
  // The item in the side panel, if one is open.
  let panel = null;
  if (open) {
    const item = await loadItem(db, open.entity, open.id);
    if (item) {
      const [evidence, latest, last, reforms] = await Promise.all([
        loadEvidence(db, open.entity, open.id),
        loadLatestSubmission(db, open.entity, open.id),
        db.query<{ changed_at: string; entered_by: string | null; entered_for: string | null }>('select changed_at::text, entered_by, entered_for from item_last_update($1, $2)', [
          open.entity,
          open.id,
        ]),
        db.query<{ reforms: string[] }>('select my_reform_ids() as reforms'),
      ]);
      const activityAllowed = mayReadActivity(user, item, reforms.rows[0]?.reforms ?? []);
      const activity = activityAllowed && panelTab === 'activity' ? await loadActivity(db, open.entity, open.id) : [];
      panel = { item, evidence, latest, last: last.rows[0] ?? null, activityAllowed, activity };
    }
  }
  return { rows: items.rows, mine: mine.rows, stats: stats.rows[0]!, tabCounts: tabCounts.rows[0]!, first: first.rows[0] ?? null, labels: lookups.rows, panel, asOf: await dataAsOf(db) };
});

// Updates waiting for this person's approval, for the Needs your action block.
const queue = accessFor(user.role).approver ? await loadQueue(user) : [];
const waitingUpdates = queue.filter((q) => !q.isConfirmation);
const waitingConfirmations = queue.filter((q) => q.isConfirmation);
const daysSince = (iso: string) => Math.floor((Date.now() - Date.parse(iso.replace(' ', 'T'))) / 86_400_000);
const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hourCycle: 'h23', timeZone: DISPLAY_TIME_ZONE }).format(new Date()));
const greeting = t(lang, hour < 12 ? 'items.greet_morning' : hour < 17 ? 'items.greet_afternoon' : 'items.greet_evening', { name: user.name.split(/\s+/)[0] ?? '' });
const fixHref = (m: { route: string; submission_id: string; entity: string | null; item_id: string | null }) =>
  m.route === 'bulk_upload' ? `/uploads/${m.submission_id}` : m.entity && m.item_id ? `/items/${m.entity}/${m.item_id}` : '/my-items';
type Action = { kind: string; icon: string; title: string; text: string; href: string; button: string; testId: string };
const actions: Action[] = [
  ...(waitingUpdates.length > 0
    ? [
        {
          kind: 'approve',
          icon: 'milestone',
          title: t(lang, 'items.action_waiting', { n: waitingUpdates.length }),
          text: daysSince(waitingUpdates[0]!.createdAt) > 0 ? t(lang, 'approvals.overview_oldest', { days: daysSince(waitingUpdates[0]!.createdAt) }) : t(lang, 'approvals.overview_today'),
          href: `/approvals/${waitingUpdates[0]!.submissionId}`,
          button: t(lang, 'items.action_review'),
          testId: 'action-approvals',
        },
      ]
    : []),
  ...(waitingConfirmations.length > 0
    ? [
        {
          kind: 'confirm',
          icon: 'confirmation',
          title: t(lang, 'items.action_confirmations', { n: waitingConfirmations.length }),
          text: t(lang, 'approvals.overview_confirmations_text'),
          href: '/approvals?show=confirmations',
          button: t(lang, 'approvals.approve_together'),
          testId: 'action-confirmations',
        },
      ]
    : []),
  ...data.mine.map((m) => ({
    kind: m.status,
    icon: m.status === 'returned' ? 'returned' : 'rule',
    title: t(lang, m.status === 'returned' ? 'items.action_returned' : 'items.action_stopped', { n: m.n }),
    text: t(lang, m.status === 'returned' ? 'items.action_returned_text' : 'items.action_stopped_text'),
    href: fixHref(m),
    button: t(lang, 'items.action_fix'),
    testId: m.status === 'returned' ? 'action-returned' : 'action-stopped',
  })),
];
const hasNext = data.rows.length > PAGE_SIZE;
const shown = data.rows.slice(0, PAGE_SIZE);
const label = (list: string, code: string) => {
  const found = data.labels.find((l) => l.list_name === list && l.code === code);
  return found ? (lang === 'fr' ? found.label_fr : found.label_en) : code;
};
const link = (changes: Record<string, string | null>) => {
  const p = new URLSearchParams(params);
  for (const [k, v] of Object.entries(changes)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  const query = p.toString();
  return `/my-items${query ? `?${query}` : ''}`;
};
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join('');
const panel = data.panel;
const record = panel?.item.record ?? {};
const dueOf = (entity: string) => (entity === 'milestone' ? 'planned_date' : 'due_date');
const s = data.stats;
const ring = { overdue: s.overdue, stale: s.ring_stale, waiting: s.ring_waiting, ok: s.total - s.overdue - s.ring_stale - s.ring_waiting };
const needYou = ring.overdue + ring.stale;
const reformLabel = (id: string | null, en: string | null, fr: string | null) => {
  if (!id) return t(lang, 'items.programme_wide');
  const name = lang === 'fr' ? (fr ?? en) : en;
  return name ? `${id} · ${name}` : id;
};
const heroLead = !data.first
  ? t(lang, 'items.hero_lead_clear')
  : data.first.days_overdue > 0
    ? t(lang, 'items.hero_lead_overdue', { name: data.first.name, days: data.first.days_overdue })
    : t(lang, 'items.hero_lead_stale', { name: data.first.name });
const parts = [
  { key: 'overdue', value: ring.overdue, colour: 'coral', label: t(lang, 'items.stat_overdue'), detail: t(lang, 'items.hero_overdue_detail') },
  { key: 'stale', value: ring.stale, colour: 'sun', label: t(lang, 'items.stat_stale'), detail: t(lang, 'items.hero_stale_detail') },
  { key: 'waiting', value: ring.waiting, colour: 'sky', label: t(lang, 'items.stat_waiting'), detail: t(lang, 'items.hero_waiting_detail') },
  { key: 'ok', value: ring.ok, colour: 'leaf', label: t(lang, 'items.hero_ok'), detail: t(lang, 'items.hero_ok_detail') },
] as const;
---

<Base title={t(lang, 'items.title')} action={BULK_ROLES.includes(user.role) ? { href: '/uploads/new', label: t(lang, 'items.action_upload') } : undefined}>
  <div class="page-head">
    <p class="greeting" data-testid="greeting">{greeting}</p>
    <h1>{t(lang, 'items.title')}</h1>
    <p>{t(lang, tab === 'mine' ? 'items.intro_mine' : 'items.intro_reforms')}</p>
    <p class="as-of" data-testid="as-of">
      {data.asOf.asOf && <>{t(lang, 'views.data_as_of', { date: formatDate(data.asOf.asOf, lang) })} · </>}
      {t(lang, 'items.stale_total', { n: data.asOf.stale })}
    </p>
  </div>

  {
    canSeeReforms && (
      <nav class="tabs" aria-label={t(lang, 'items.title')}>
        <a href="/my-items" aria-current={tab === 'mine' ? 'page' : undefined}>
          {t(lang, 'items.tab_mine')} <span class="tab-pill">{data.tabCounts.mine}</span>
        </a>
        <a href="/my-items?tab=reforms" aria-current={tab === 'reforms' ? 'page' : undefined}>
          {t(lang, 'items.tab_reforms')} <span class="tab-pill">{data.tabCounts.reforms ?? 0}</span>
        </a>
      </nav>
    )
  }

  {
    s.total > 0 && (
      <section class="hero" aria-labelledby="hero-title" data-testid="items-hero">
        <HeroLeaves id="items-leaves" />
        <Ring
          id="items-ring"
          size={168}
          parts={parts.map((p) => ({ value: p.value, colour: p.colour }))}
          label={t(lang, 'items.hero_ring_label', { overdue: ring.overdue, stale: ring.stale, waiting: ring.waiting, ok: ring.ok, total: s.total })}
        >
          <span class="ring-number">{needYou}</span>
          <span class="ring-of">{t(lang, 'items.hero_ring_of', { total: s.total })}</span>
        </Ring>
        <div class="hero-text">
          <h2 id="hero-title">{needYou === 0 ? t(lang, 'items.hero_title_clear') : t(lang, tab === 'mine' ? 'items.hero_title_mine' : 'items.hero_title_reforms', { n: needYou })}</h2>
          <p class="hero-lead">{heroLead}</p>
          <ul class="breakdown">
            {parts.map((p) => (
              <li data-part={p.key}>
                <span class={`dot dot-${p.key}`} aria-hidden="true" />
                <span class="part">{p.label}</span>
                <span class="count">
                  {p.value}/{s.total}
                </span>
                <span class="detail">{p.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    actions.length > 0 && (
      <section class="needs" aria-labelledby="needs-title" data-testid="needs-action">
        <h2 id="needs-title">{t(lang, 'items.needs_title')}</h2>
        <ul>
          {actions.map((a) => (
            <li data-testid={a.testId}>
              <a href={a.href}>
                <ObjectIcon kind={a.icon} />
                <span class="needs-text">
                  <strong>{a.title}</strong>
                  <span class="sub">{a.text}</span>
                </span>
                <span class="btn btn-secondary">{a.button}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <ul class="stats" aria-label={t(lang, 'items.stats_label')}>
    <StatCard label={t(lang, 'items.stat_overdue')} value={s.overdue} tone={s.overdue > 0 ? 'red' : 'default'} href={link({ show: show === 'overdue' ? null : 'overdue', page: null, open: null })} selected={show === 'overdue'} context={t(lang, 'items.stat_overdue_context')} testId="stat-overdue" />
    <StatCard label={t(lang, 'items.stat_due30')} value={s.due30} href={link({ show: show === 'due30' ? null : 'due30', page: null, open: null })} selected={show === 'due30'} context={t(lang, 'items.stat_due30_context')} testId="stat-due30" />
    <StatCard label={t(lang, 'items.stat_stale')} value={s.stale} tone={s.stale > 0 ? 'amber' : 'default'} href={link({ show: show === 'stale' ? null : 'stale', page: null, open: null })} selected={show === 'stale'} context={t(lang, 'items.stat_stale_context')} testId="stat-stale" />
    <StatCard label={t(lang, 'items.stat_waiting')} value={s.waiting} href={link({ show: show === 'waiting' ? null : 'waiting', page: null, open: null })} selected={show === 'waiting'} context={t(lang, 'items.stat_waiting_context')} testId="stat-waiting" />
  </ul>

  {
    (tab === 'reforms' || show) && (
      <form method="get" class="filters">
        {tab === 'reforms' && <input type="hidden" name="tab" value="reforms" />}
        {show && <input type="hidden" name="show" value={show} />}
        {tab === 'reforms' && (
          <label class="inline">
            <input type="checkbox" name="no_owner" value="1" checked={noOwnerOnly} />
            {t(lang, 'items.filter_no_owner')}
          </label>
        )}
        {tab === 'reforms' && (
          <button class="btn btn-secondary" type="submit">
            {t(lang, 'items.apply')}
          </button>
        )}
        {show && (
          <a class="btn btn-ghost" href={link({ show: null, page: null, open: null })}>
            {t(lang, 'items.clear_filter', { filter: t(lang, `items.stat_${show}` as MessageKey) })}
          </a>
        )}
      </form>
    )
  }

  {
    shown.length === 0 ? (
      <EmptyState
        message={show ? t(lang, 'items.empty_filtered') : t(lang, tab === 'mine' ? 'items.empty_mine' : 'items.empty')}
        action={show ? { href: link({ show: null, page: null }), label: t(lang, 'items.show_all') } : undefined}
      />
    ) : (
      <div class="table-wrap">
        <table class="data-table" data-testid="items">
          <thead>
            <tr>
              <th scope="col">{t(lang, 'items.col_item')}</th>
              <th scope="col">{t(lang, 'items.col_status')}</th>
              <th scope="col">{t(lang, 'items.col_due')}</th>
              <th scope="col">{t(lang, 'items.col_rag')}</th>
              {tab === 'reforms' && <th scope="col">{t(lang, 'items.col_owner')}</th>}
              <th scope="col">{t(lang, 'items.col_confirmed')}</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((row) => (
              <tr aria-selected={open?.entity === row.object_type && open.id === row.object_id ? 'true' : undefined}>
                <td>
                  <div class="item-cell">
                    <ReformChip reformId={row.reform_id} label={reformLabel(row.reform_id, row.reform_name_en, row.reform_name_fr)} compact />
                    <div class="item-text">
                      <span class={`item-reform reform-text-${row.reform_id?.toLowerCase() ?? 'programme'}`} aria-hidden="true">
                        {reformLabel(row.reform_id, row.reform_name_en, row.reform_name_fr)}
                      </span>
                      <a class="row-link" href={link({ open: `${row.object_type}/${row.object_id}`, panel: null })}>
                        {row.name}
                      </a>
                      {row.is_sample && <SampleBadge />}
                      <span class="sub">
                        {t(lang, `items.type_${row.object_type}` as MessageKey)} · {row.object_id}
                        {row.pending && (
                          <>
                            {' '}
                            <span class="pill pill-accent">{t(lang, `items.pending_${row.pending}` as MessageKey)}</span>
                          </>
                        )}
                      </span>
                    </div>
                  </div>
                </td>
                <td>
                  <StatusPill status={row.status} label={label('delivery_status', row.status)} />
                </td>
                <td class="tabular due-cell">
                  <DueBar daysOverdue={row.days_overdue} daysToDue={row.days_to_due} hasDueDate={row.due_date !== null} />
                  {row.due_date ? formatDate(row.due_date, lang) : ''}
                  {row.days_overdue > 0 ? (
                    <span class="late">{t(lang, 'items.overdue', { days: row.days_overdue })}</span>
                  ) : (
                    row.days_to_due !== null && <span class="sub">{t(lang, 'items.days_left', { days: row.days_to_due })}</span>
                  )}
                </td>
                <td>
                  <RagPill rag={row.rag} label={label('rag', row.rag)} />
                </td>
                {tab === 'reforms' && (
                  <td>
                    {row.owner_name ? (
                      <>
                        <span class="avatar" aria-hidden="true">
                          {initials(row.owner_name)}
                        </span>
                        {row.owner_name}
                      </>
                    ) : (
                      <span class="late">{t(lang, 'items.no_owner')}</span>
                    )}
                  </td>
                )}
                <td class="tabular">
                  {row.last_confirmed_at ? formatDate(row.last_confirmed_at, lang) : t(lang, 'items.never')}
                  {row.is_stale && <span class="sub stale">{t(lang, 'items.stale')}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    (page > 1 || hasNext) && (
      <nav class="pager">
        {page > 1 && <a href={link({ page: String(page - 1), open: null })}>{t(lang, 'items.previous')}</a>}
        <span>{t(lang, 'items.page', { n: page })}</span>
        {hasNext && <a href={link({ page: String(page + 1), open: null })}>{t(lang, 'items.next')}</a>}
      </nav>
    )
  }

  {
    open && !panel && (
      <SidePanel title={t(lang, 'items.panel_missing_title')} closeHref={link({ open: null })}>
        <p>{t(lang, 'items.panel_missing')}</p>
      </SidePanel>
    )
  }
  {
    panel && (
      <SidePanel title={String(record['name'] ?? panel.item.id)} closeHref={link({ open: null, panel: null })}>
        <details class="menu panel-menu" data-menu slot="actions" data-testid="panel-actions">
          <summary class="btn btn-secondary">
            {t(lang, 'items.actions')} <Icon name="chevron_down" />
          </summary>
          <div class="menu-panel">
            <a class="menu-row" href={`/items/${panel.item.entity}/${panel.item.id}`}>
              <span class="menu-icon" aria-hidden="true">
                <Icon name="file" />
              </span>
              <span class="menu-row-title">{t(lang, 'items.action_full')}</span>
            </a>
            {['super_admin', 'programme_admin'].includes(user.role) && (
              <a class="menu-row" href="/on-behalf">
                <span class="menu-icon" aria-hidden="true">
                  <Icon name="someone" />
                </span>
                <span class="menu-row-title">{t(lang, 'items.action_on_behalf')}</span>
              </a>
            )}
            {panel.item.reformId && (
              <a class="menu-row" href={`/pathway?reform=${panel.item.reformId}`}>
                <span class="menu-icon" aria-hidden="true">
                  <Icon name="pathway" />
                </span>
                <span class="menu-row-title">{t(lang, 'items.action_pathway')}</span>
              </a>
            )}
          </div>
        </details>

        <p class="panel-type">
          <ObjectIcon kind={panel.item.entity} size="sm" />
          {t(lang, `items.type_${panel.item.entity}` as MessageKey)} · {panel.item.id}
          {record['is_sample'] === true && <SampleBadge />}
        </p>
        <div class="panel-pills">
          <StatusPill status={String(record['status'] ?? '')} label={label('delivery_status', String(record['status'] ?? ''))} />
          <RagPill rag={panel.item.rag} label={label('rag', panel.item.rag)} />
          {panel.latest?.status === 'proposed' && <span class="pill pill-accent">{t(lang, 'items.pending_proposed')}</span>}
        </div>

        {panel.activityAllowed && (
          <nav class="tabs panel-tabs" aria-label={t(lang, 'items.panel_tabs')}>
            <a href={link({ panel: null })} aria-current={panelTab === 'overview' ? 'page' : undefined}>
              {t(lang, 'items.panel_overview')}
            </a>
            <a href={link({ panel: 'activity' })} aria-current={panelTab === 'activity' ? 'page' : undefined} data-testid="tab-activity">
              {t(lang, 'items.panel_activity')}
            </a>
          </nav>
        )}

        {panelTab === 'activity' && panel.activityAllowed ? (
          <ActivityList events={panel.activity} />
        ) : (
          <>
            {(() => {
              const warning =
                panel.latest?.status === 'returned'
                  ? t(lang, 'items.warn_returned')
                  : panel.latest?.status === 'proposed'
                    ? t(lang, 'items.warn_pending')
                    : panel.item.daysOverdue > 0
                      ? t(lang, 'items.warn_overdue', { days: panel.item.daysOverdue })
                      : panel.item.isStale
                        ? t(lang, 'items.warn_stale')
                        : null;
              const tone = panel.latest?.status === 'proposed' ? 'info' : 'warn';
              return (
                warning && (
                  <p class={`panel-warning tone-${tone}`} data-testid="panel-warning">
                    <Icon name={tone === 'info' ? 'clock' : 'warning'} />
                    {warning}
                  </p>
                )
              );
            })()}

            <div class="due-block">
              <span class="due-label">{t(lang, 'card.due')}</span>
              <span class="due-date tabular">{record[dueOf(panel.item.entity)] ? formatDate(String(record[dueOf(panel.item.entity)]), lang) : t(lang, 'items.none')}</span>
              <DueBar daysOverdue={panel.item.daysOverdue} daysToDue={panel.item.daysToDue} hasDueDate={Boolean(record[dueOf(panel.item.entity)])} />
              {panel.item.daysOverdue > 0 ? (
                <span class="late">{t(lang, 'items.overdue', { days: panel.item.daysOverdue })}</span>
              ) : (
                panel.item.daysToDue !== null && <span class="sub">{t(lang, 'items.days_left', { days: panel.item.daysToDue })}</span>
              )}
            </div>

            <dl class="facts">
              <dt>{t(lang, 'card.reform')}</dt>
              <dd>
                <ReformChip reformId={panel.item.reformId} label={panel.item.reformId ?? t(lang, 'items.programme_wide')} />
              </dd>
              <dt>{t(lang, 'card.owner')}</dt>
              <dd>{panel.item.ownerName ?? <span class="late">{t(lang, 'items.no_owner')}</span>}</dd>
              <dt>{t(lang, 'card.last_confirmed')}</dt>
              <dd class="tabular">
                {record['last_confirmed_at'] ? formatDate(String(record['last_confirmed_at']), lang) : t(lang, 'items.never')}
                {panel.item.isStale && <span class="sub stale">{t(lang, 'items.stale')}</span>}
              </dd>
              {record['next_action'] && (
                <>
                  <dt>{t(lang, 'card.next_action')}</dt>
                  <dd>{String(record['next_action'])}</dd>
                </>
              )}
              {record['blocker'] && (
                <>
                  <dt>{t(lang, 'card.blocker')}</dt>
                  <dd>{String(record['blocker'])}</dd>
                </>
              )}
            </dl>

            <div class="panel-actions">
              <a class="btn" href={`/items/${panel.item.entity}/${panel.item.id}`} data-testid="panel-update">
                {t(lang, 'items.panel_update')}
              </a>
              {tab === 'mine' && panel.latest?.status !== 'proposed' && (
                <form method="post" action={`/items/${panel.item.entity}/${panel.item.id}`}>
                  <input type="hidden" name="action" value="confirm" />
                  <input type="hidden" name="base_updated_at" value={panel.item.version} />
                  <button class="btn btn-secondary" type="submit">
                    {t(lang, 'card.nothing_changed')}
                  </button>
                </form>
              )}
            </div>

            <details class="attached" open={panel.evidence.length > 0 && panel.evidence.length <= 3}>
              <summary>
                <ObjectIcon kind="evidence" size="sm" />
                {t(lang, 'items.attached', { n: panel.evidence.length })}
              </summary>
              {panel.evidence.length === 0 ? (
                <p class="muted">{t(lang, 'evidence.none')}</p>
              ) : (
                <ul class="evidence">
                  {panel.evidence.map((e) => (
                    <li>
                      {e.hasFile ? <a href={`/evidence/${e.evidenceId}`}>{e.title}</a> : e.title}{' '}
                      <span class="pill pill-grey">{label('validation_status', e.validationStatus)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </details>

            {panel.last?.entered_by ? (
              <p class="muted last-update" data-testid="panel-history">
                {panel.last.entered_for
                  ? t(lang, 'onbehalf.last_update_for', { date: formatDate(panel.last.changed_at, lang), by: panel.last.entered_by, for: panel.last.entered_for })
                  : t(lang, 'onbehalf.last_update', { date: formatDate(panel.last.changed_at, lang), by: panel.last.entered_by })}
              </p>
            ) : (
              <p class="muted last-update">{t(lang, 'items.history_none')}</p>
            )}
          </>
        )}
      </SidePanel>
    )
  }
</Base>


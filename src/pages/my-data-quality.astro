---
// My data quality (decisions 44 and 90): each person's own figures and the checks they trip most
// often, so they can improve without waiting for training. Only their own runs, whatever their
// role. Four tiles, the trend beside the checks, then the attempts.
import BarList from '../components/BarList.astro';
import DqSummary from '../components/DqSummary.astro';
import EmptyState from '../components/EmptyState.astro';
import QualityTrend from '../components/QualityTrend.astro';
import Base from '../layouts/Base.astro';
import { formatDateTime, formatNumber, t, type MessageKey } from '../i18n';
import { ownReport, PAGE_SIZE, readFilter, recentMonths, ROUTES, TRAINING_WINDOW } from '../lib/admin/data-quality';
import { withoutRowPrefix } from '../lib/gate/messages';

const { lang, user } = Astro.locals;
if (!user) return Astro.redirect('/sign-in?next=%2Fmy-data-quality', 303);

const filter = readFilter(Astro.url.searchParams, []);
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const report = await ownReport(user.claims, user.userId, filter, page);
const pages = Math.max(1, Math.ceil(report.attempts.total / PAGE_SIZE));

const score = (value: number | null) => (value === null ? t(lang, 'dq.none') : formatNumber(value, lang));
const ruleName = (id: string) => {
  try {
    return t(lang, `rules.${id}` as MessageKey);
  } catch {
    return id;
  }
};
const monthLabel = (month: string) =>
  new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${month}-01T00:00:00Z`));
// The same rule can appear in several months; here each rule once, with its total.
const rules = [...report.rules.reduce((all, r) => {
  const seen = all.get(r.ruleId);
  all.set(r.ruleId, { ruleId: r.ruleId, failures: (seen?.failures ?? 0) + r.failures, example: seen?.example ?? (lang === 'fr' ? r.exampleFr : r.exampleEn) });
  return all;
}, new Map<string, { ruleId: string; failures: number; example: string }>()).values()].sort((a, b) => b.failures - a.failures || a.ruleId.localeCompare(b.ruleId));
const pageLink = (n: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(n));
  return `?${params.toString()}`;
};
---

<Base title={t(lang, 'dq.my_title')}>
  <div class="page-head">
    <h1>{t(lang, 'dq.my_title')}</h1>
    <p>{t(lang, 'dq.my_intro')}</p>
  </div>

  <form method="get" class="filters">
    <div>
      <label for="period">{t(lang, 'dq.filter_period')}</label>
      <select id="period" name="period">
        <option value="last3" selected={filter.period === 'last3'}>{t(lang, 'dq.last3')}</option>
        <option value="last12" selected={filter.period === 'last12'}>{t(lang, 'dq.last12')}</option>
        {recentMonths().map((m) => <option value={m} selected={filter.period === m}>{monthLabel(m)}</option>)}
      </select>
    </div>
    <div>
      <label for="route">{t(lang, 'dq.filter_route')}</label>
      <select id="route" name="route">
        <option value="">{t(lang, 'views.all')}</option>
        {ROUTES.map((r) => <option value={r} selected={filter.route === r}>{t(lang, `approvals.route_${r}` as MessageKey)}</option>)}
      </select>
    </div>
    <button class="btn btn-secondary" type="submit">{t(lang, 'views.apply')}</button>
  </form>

  {
    report.training && (
      <p class="notice" data-testid="my-training">
        {t(lang, 'dq.my_training', { passes: report.training.passes, n: TRAINING_WINDOW })}
      </p>
    )
  }

  <DqSummary headline={report.headline} />

  <div class="overview">
    <section class="card" aria-labelledby="my-trend-title">
      <h2 id="my-trend-title">{t(lang, 'dq.trend_title')}</h2>
      {report.trend.length === 0 ? (
        <EmptyState icon="quality" title={t(lang, 'dq.trend_none_title')} message={t(lang, 'views.trend_none')} testId="trend-empty" />
      ) : (
        <QualityTrend id="my-trend" points={report.trend} showPassRate />
      )}
    </section>
    <section class="card" aria-labelledby="my-rules-title">
      <h2 id="my-rules-title">{t(lang, 'dq.my_rules_title')}</h2>
      {rules.length === 0 ? (
        <EmptyState icon="approvals" title={t(lang, 'dq.my_rules_none_title')} message={t(lang, 'dq.my_rules_none')} testId="my-rules-empty" />
      ) : (
        <BarList
          testId="my-rules"
          tone="sun"
          items={rules.slice(0, 5).map((r) => ({
            label: `${r.ruleId} ${ruleName(r.ruleId)}`,
            value: r.failures,
            href: `/rules?open=${encodeURIComponent(r.ruleId)}`,
            sub: t(lang, 'dq.example', { text: withoutRowPrefix(r.example) }),
          }))}
        />
      )}
    </section>
  </div>

  <section class="attempts" aria-labelledby="my-attempts-title">
    <h2 id="my-attempts-title">{t(lang, 'dq.my_attempts_title')}</h2>
    {
      report.attempts.rows.length === 0 ? (
        <EmptyState icon="data" title={t(lang, 'dq.attempts_none_title')} message={t(lang, 'dq.no_attempts')} />
      ) : (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">{t(lang, 'dq.when')}</th>
                <th scope="col">{t(lang, 'dq.filter_route')}</th>
                <th scope="col" class="number">{t(lang, 'dq.attempt_no')}</th>
                <th scope="col" class="number">{t(lang, 'dq.score')}</th>
                <th scope="col">{t(lang, 'dq.outcome')}</th>
              </tr>
            </thead>
            <tbody>
              {report.attempts.rows.map((a) => (
                <tr data-outcome={a.outcome}>
                  <td>{a.isUpload ? <a href={`/uploads/${a.submissionId}`}>{formatDateTime(a.startedAt, lang)}</a> : formatDateTime(a.startedAt, lang)}</td>
                  <td>{t(lang, `approvals.route_${a.route}` as MessageKey)}</td>
                  <td class="number">{a.attemptNo}</td>
                  <td class="number">{score(a.score)}</td>
                  <td>
                    <span class={`pill ${a.outcome === 'pass' ? 'pill-green' : 'pill-red'}`}>{a.outcome === 'pass' ? t(lang, 'dq.outcome_pass') : t(lang, 'dq.outcome_reject')}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {
      pages > 1 && (
        <nav class="pager">
          {page > 1 && <a href={pageLink(page - 1)}>{t(lang, 'items.previous')}</a>}
          <span>{t(lang, 'items.page', { n: page })}</span>
          {page < pages && <a href={pageLink(page + 1)}>{t(lang, 'items.next')}</a>}
        </nav>
      )
    }
  </section>
</Base>

<style>
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-4);
    align-items: start;
  }
  .overview h2,
  .attempts h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
  }
  .attempts {
    margin-top: var(--space-8);
  }
  @media (max-width: 1023px) {
    .overview {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

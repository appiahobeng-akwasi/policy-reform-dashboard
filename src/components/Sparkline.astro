---
// A small trend for an indicator's approved values (docs/08 v0.2: hand-written SVG): a gradient
// line over a fading fill. Drawn only with two or more values; the values are in its label.
import { area } from '../lib/charts';

interface Props {
  values: { periodEnd: string; value: number }[];
  label: string;
  /** Unique on the page: the gradients are named after it. */
  id: string;
}
const { values, label, id } = Astro.props;
const min = Math.min(...values.map((v) => v.value));
const max = Math.max(...values.map((v) => v.value));
const spread = max - min || 1;
const trend = area(
  values.map((v) => v.value),
  { width: 96, height: 28, left: 3, right: 4, top: 4, bottom: 3 },
  min - spread * 0.1,
  max + spread * 0.1,
);
const last = trend.points.at(-1);
---

{
  values.length > 1 && (
    <svg viewBox="0 0 96 28" width="96" height="28" role="img" aria-label={label} class="spark">
      <defs>
        <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#4fe0ad" stop-opacity="0.4" />
          <stop offset="1" stop-color="#4fe0ad" stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${id}-line`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#7fdc8f" />
          <stop offset="1" stop-color="#008a63" />
        </linearGradient>
      </defs>
      <path d={trend.fill} fill={`url(#${id}-fill)`} />
      <path d={trend.line} fill="none" stroke={`url(#${id}-line)`} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      {last && <circle cx={last.x} cy={last.y} r="2.5" fill="#008a63" />}
    </svg>
  )
}

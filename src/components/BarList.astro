---
// "Who or what has the most", as horizontal gradient bars measured against the largest (docs/08
// v0.2 section 4). Each row has its name and number in text; the bar is decoration. Lengths are
// 5% steps (no inline styles under the content policy).
import { barSteps } from '../lib/charts';

export type BarItem = { label: string; value: number; sub?: string | undefined; href?: string | undefined };
interface Props {
  items: BarItem[];
  tone?: 'coral' | 'sun' | 'emerald' | 'sky';
  testId?: string;
}
const { items, tone = 'coral', testId } = Astro.props;
const steps = barSteps(items.map((i) => i.value));
---

<ul class="bar-list" data-testid={testId}>
  {
    items.map((item, i) => (
      <li>
        <span class="bar-text">
          {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
          {item.sub && <span class="bar-sub">{item.sub}</span>}
        </span>
        <span class="bar-value">{item.value}</span>
        <span class="bar-track" aria-hidden="true">
          <span class={`bar-fill tone-${tone} w-${steps[i]}`} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .bar-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }
  .bar-text {
    display: grid;
    min-width: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere;
  }
  .bar-sub {
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    color: var(--color-text-muted);
  }
  .bar-value {
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }
  .bar-track {
    grid-column: 1 / -1;
    position: relative;
    height: 0.5rem;
    border-radius: var(--radius-round);
    background: var(--color-surface-hover);
    overflow: hidden;
  }
  .bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: var(--radius-round);
  }
  .tone-coral { background: var(--gradient-coral); }
  .tone-sun { background: var(--gradient-sun); }
  .tone-emerald { background: var(--gradient-emerald); }
  .tone-sky { background: var(--gradient-sky); }
</style>

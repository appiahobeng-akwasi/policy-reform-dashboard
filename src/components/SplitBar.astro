---
// Parts of a whole in one rounded bar, with even gaps (docs/08 v0.2 section 4): red, amber,
// green, grey and blue ratings, or any other split. Widths are 5% steps (no inline styles under
// the content policy). The legend gives each part's name and count, so colour is never alone.
import { splitSteps } from '../lib/charts';

export type SplitPart = { tone: 'red' | 'amber' | 'green' | 'grey' | 'blue' | 'emerald'; label: string; value: number };
interface Props {
  parts: SplitPart[];
  label: string;
  legend?: boolean;
}
const { parts, label, legend = true } = Astro.props;
const steps = splitSteps(parts.map((p) => p.value));
const total = parts.reduce((sum, p) => sum + p.value, 0);
---

<div class="split-wrap">
  <span class="split" role="img" aria-label={`${label}: ${parts.map((p) => `${p.label} ${p.value}`).join(', ')}`}>
    {total === 0 ? <i class="empty w-100" /> : parts.map((p, i) => steps[i]! > 0 && <i class={`tone-${p.tone} w-${steps[i]}`} />)}
  </span>
  {
    legend && (
      <ul class="legend" aria-hidden="true">
        {parts
          .filter((p) => p.value > 0)
          .map((p) => (
            <li>
              <span class={`key tone-${p.tone}`} />
              {p.label} <strong>{p.value}</strong>
            </li>
          ))}
      </ul>
    )
  }
</div>

<style>
  .split {
    display: flex;
    gap: 3px;
    height: 0.625rem;
  }
  .split i {
    display: block;
    flex: 0 1 auto;
    min-width: 0.375rem;
    border-radius: var(--radius-round);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .legend strong {
    color: var(--color-text);
  }
  .key {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .tone-red { background: var(--gradient-coral); }
  .tone-amber { background: var(--gradient-sun); }
  .tone-green { background: var(--gradient-leaf); }
  .tone-blue { background: var(--gradient-sky); }
  .tone-emerald { background: var(--gradient-emerald); }
  .tone-grey { background: var(--gradient-elapsed); }
  .empty { background: var(--color-surface-hover); }
</style>

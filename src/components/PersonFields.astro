---
// Fields for someone on the people list: owners of items who may not sign in (decision 24).
import { t } from '../i18n';
import type { PersonInput, Problem } from '../lib/admin/users';

interface Props {
  value: PersonInput;
  institutions: { id: string; label: string }[];
  problems: Problem[];
}
const { value, institutions, problems } = Astro.props;
const { lang } = Astro.locals;
---

<div>
  <label for="name">{t(lang, 'admin.name')}</label>
  <input id="name" name="name" type="text" value={value.name} required maxlength="200" autocomplete="off" />
  {problems.includes('name') && <p class="hint-error">{t(lang, 'admin.problem_name')}</p>}
</div>
<div>
  <label for="email">{t(lang, 'admin.email_optional')}</label>
  <input id="email" name="email" type="email" value={value.email ?? ''} maxlength="320" autocomplete="off" />
  {problems.includes('email') && <p class="hint-error">{t(lang, 'admin.problem_email')}</p>}
  <p class="muted">{t(lang, 'admin.person_email_hint')}</p>
</div>
<div>
  <label for="institution">{t(lang, 'admin.institution')}</label>
  <select id="institution" name="institution">
    <option value="">{t(lang, 'admin.institution_none')}</option>
    {institutions.map((i) => <option value={i.id} selected={value.institutionId === i.id}>{i.label}</option>)}
  </select>
  {problems.includes('institution') && <p class="hint-error">{t(lang, 'admin.problem_institution')}</p>}
</div>
<div>
  <label for="role_title">{t(lang, 'admin.role_title')}</label>
  <input id="role_title" name="role_title" type="text" value={value.roleTitle ?? ''} maxlength="200" autocomplete="off" />
</div>
<div>
  <label for="language">{t(lang, 'admin.language')}</label>
  <select id="language" name="language">
    <option value="fr" selected={value.language === 'fr'}>{t(lang, 'language.fr_name')}</option>
    <option value="en" selected={value.language === 'en'}>{t(lang, 'language.en_name')}</option>
  </select>
</div>

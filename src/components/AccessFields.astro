---
// The fields that say who someone is and what they may do: used to add, edit and give access.
// Only a super administrator is offered the super administrator role (the database checks too).
import { t, type MessageKey } from '../i18n';
import { ROLES, type Problem, type Scope } from '../lib/admin/users';

interface Props {
  value: { name: string; email: string; role: string; language: string; scope: Scope[] };
  reforms: string[];
  canGrantSuper: boolean;
  problems: Problem[];
  /** Name and email come from the people list when giving someone access. */
  identity?: boolean;
}
const { value, reforms, canGrantSuper, problems, identity = true } = Astro.props;
const { lang } = Astro.locals;
const roles = ROLES.filter((r) => canGrantSuper || r !== 'super_admin' || value.role === 'super_admin');
const scopeOf = (reform: string) => value.scope.find((s) => s.reformId === reform);
---

{
  identity && (
    <>
      <div>
        <label for="name">{t(lang, 'admin.name')}</label>
        <input id="name" name="name" type="text" value={value.name} required maxlength="200" autocomplete="off" aria-invalid={problems.includes('name') ? 'true' : undefined} />
        {problems.includes('name') && <p class="hint-error">{t(lang, 'admin.problem_name')}</p>}
      </div>
      <div>
        <label for="email">{t(lang, 'admin.email')}</label>
        <input id="email" name="email" type="email" value={value.email} required maxlength="320" autocomplete="off" aria-invalid={problems.includes('email') ? 'true' : undefined} />
        {problems.includes('email') && <p class="hint-error">{t(lang, 'admin.problem_email')}</p>}
        <p class="muted">{t(lang, 'admin.email_hint')}</p>
      </div>
    </>
  )
}
<div>
  <label for="role">{t(lang, 'admin.role')}</label>
  <select id="role" name="role" required>
    {roles.map((r) => <option value={r} selected={value.role === r}>{t(lang, `roles.${r}` as MessageKey)}</option>)}
  </select>
  {problems.includes('role') && <p class="hint-error">{t(lang, 'admin.problem_role')}</p>}
  <p class="muted">{t(lang, 'admin.role_hint')}</p>
</div>
{
  identity && (
    <div>
      <label for="language">{t(lang, 'admin.language')}</label>
      <select id="language" name="language">
        <option value="en" selected={value.language === 'en'}>{t(lang, 'language.en_name')}</option>
        <option value="fr" selected={value.language === 'fr'}>{t(lang, 'language.fr_name')}</option>
      </select>
    </div>
  )
}
<fieldset>
  <legend>{t(lang, 'admin.reforms')}</legend>
  <p class="muted">{t(lang, 'admin.reforms_hint')}</p>
  {
    reforms.map((r) => (
      <div class="scope">
        <label class="inline">
          <input type="checkbox" name={`scope_${r}`} checked={Boolean(scopeOf(r))} />
          {t(lang, 'admin.works_on', { reform: r })}
        </label>
        <label class="inline">
          <input type="checkbox" name={`approve_${r}`} checked={scopeOf(r)?.canApprove === true} />
          {t(lang, 'admin.approves', { reform: r })}
        </label>
      </div>
    ))
  }
</fieldset>

<style>
  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  legend {
    font-weight: var(--weight-bold);
  }
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }
  .inline {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: var(--weight-normal);
    min-height: 2.75rem;
  }
</style>

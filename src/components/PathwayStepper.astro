---
// One reform's pathway as a stepper (decision 89): numbered circles on one thin line, a tick once
// a stage is complete, the stage under way ringed in green (red when blocked). Each step is a link
// to the stage in the side panel, with its status in words for screen readers. On a phone the
// steps stack into a vertical list.
import { t } from '../i18n';
import { reached, type StageState } from '../lib/pathway';
import Icon from './Icon.astro';

interface Step {
  code: string;
  label: string;
  state: StageState;
  statusLabel: string;
  date: string | null;
  escalation: boolean;
  href: string;
}
interface Props {
  steps: Step[];
  label: string;
}
const { steps, label } = Astro.props;
const { lang } = Astro.locals;
---

<ol class="stepper" aria-label={label}>
  {
    steps.map((s, i) => (
      <li
        class:list={['step', `step-${s.state}`, { 'next-on': i < steps.length - 1 && reached(steps[i + 1]!.state) }]}
        data-stage={s.code}
        data-state={s.state}
        aria-current={s.state === 'current' || s.state === 'blocked' ? 'step' : undefined}
      >
        <a class="step-link" href={s.href}>
          <span class="step-node" aria-hidden="true">
            {s.state === 'done' ? <Icon name="approvals" /> : i + 1}
          </span>
          <span class="step-text">
            <span class="step-name">{s.label}</span>
            <span class="visually-hidden">: {s.statusLabel}</span>
            {s.date && <span class="step-date">{s.date}</span>}
            {s.escalation && (
              <span class="step-flag">
                <span class="step-flag-icon" aria-hidden="true">
                  <Icon name="warning" />
                </span>
                <span class="visually-hidden">{t(lang, 'views.pw_escalation_flag')}</span>
              </span>
            )}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .stepper {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
  }
  /* The line to the next step, from this circle's centre to the next one's. */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0.875rem;
    left: 50%;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: var(--color-border);
  }
  .step.next-on::after {
    background: var(--color-primary);
  }
  .step-link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: 0 var(--space-1);
    color: var(--color-text);
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .step-node {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background: var(--color-surface);
    border: 1px solid var(--color-text-faint);
    color: var(--color-text-muted);
    transition: box-shadow var(--motion);
  }
  .step-node :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .step-done .step-node {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .step-current .step-node {
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
  }
  .step-blocked .step-node {
    border: 2px solid var(--color-rag-red);
    color: var(--color-rag-red);
  }
  .step-link:hover .step-node,
  .step-link:focus-visible .step-node {
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }
  .step-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }
  .step-name {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: 1.3;
    hyphens: auto;
  }
  .step-todo .step-name {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }
  .step-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .step-flag-icon {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    color: var(--color-rag-amber);
  }
  .step-flag-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* On a phone: a vertical list, the line running down the left. */
  @media (max-width: 767px) {
    .stepper {
      grid-auto-flow: row;
      gap: var(--space-3);
    }
    .step:not(:last-child)::after {
      top: 1.75rem;
      left: calc(0.875rem + var(--space-1));
      width: 2px;
      height: calc(100% - 1.75rem + var(--space-3));
      margin: 0 0 0 -1px;
    }
    .step-link {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-3);
      text-align: left;
    }
    .step-node {
      flex: none;
    }
    .step-text {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 var(--space-2);
      padding-top: 0.3rem;
    }
    .step-name {
      font-size: var(--text-sm);
    }
  }
</style>

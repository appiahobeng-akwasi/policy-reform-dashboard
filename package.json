{
  "name": "ggp-pillar1-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "GGP Pillar 1 Policy Reform Dashboard (DRC)",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "build:email-templates": "tsx scripts/build-email-templates.ts",
    "users:add": "tsx scripts/users-add.ts",
    "users:link": "tsx scripts/users-link.ts",
    "hosted:setup": "tsx scripts/hosted-setup.ts",
    "hosted:email": "tsx scripts/hosted-email.ts",
    "test:e2e": "playwright test",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "people:add": "tsx scripts/people-add.ts",
    "jobs": "tsx scripts/jobs.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "load-test": "tsx scripts/load-test.ts",
    "sample:load": "tsx scripts/sample-data.ts load",
    "sample:remove": "tsx scripts/sample-data.ts remove"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "~2.117.0",
    "@tus/s3-store": "^2.1.0",
    "@tus/server": "^2.4.7",
    "astro": "^7.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tus-js-client": "^4.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/vercel": "^11.0.18",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
